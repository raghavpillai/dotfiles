# Platforms
alias arm="env /usr/bin/arch -arm64 /bin/zsh --login"
alias intel="env /usr/bin/arch -x86_64 /bin/zsh --login"

alias ibrew='arch -x86_64 /usr/local/bin/brew'
alias mbrew='arch -arm64e /opt/homebrew/bin/brew'

# ts/js stuff
alias p='pnpm'
alias n='npm'
alias y='yarn'
alias b='bun'

# nav
alias ls='eza'
alias r="source ranger"

# Shortcuts
alias copyssh="pbcopy < $HOME/.ssh/id_ed25519.pub"
alias reloadshell="omz reload"

# Directories
alias dotfiles="cd $HOME/dev/dotfiles"
alias dev="cd $HOME/dev"
alias speck="cd $HOME/dev/speck"
alias home="cd $HOME"

# Git
alias g='git'
alias gc='gencommit'
alias gs="git status"
alias gb="git branch"
alias gl="git log --oneline --decorate --color"
alias gg="lazygit"
alias pr="gh pr create -B main -f && gh pr view --web"

alias amend="git add . && git commit --amend --no-edit"
alias commit="git add . && git commit -m"
alias diff="git diff"
alias pull="git pull"
alias push="git push"
alias checkout="git checkout"
alias clone="git clone"

# Apps
alias code="zed"
alias claude="SHELL=/bin/bash claude"
alias br="branchlet"

aliases() {
  grep '^alias ' "$HOME/.aliases" | while IFS= read -r line; do
    name=${line#alias }
    name=${name%%=*}

    value=${line#*=}
    value=${value#\'}
    value=${value#\"}
    value=${value%\'}
    value=${value%\"}

    printf "%s\t%s\n" "$name" "$value"
  done | column -s $'\t' -t
}
