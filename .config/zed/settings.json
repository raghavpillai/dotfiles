// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette
{
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "default_model": {
      "provider": "zed.dev",
      "model": "claude-sonnet-4-6"
    },
    "favorite_models": [],
    "model_parameters": []
  },
  "formatter": {
    "external": {
      "command": "biome",
      "arguments": ["format", "--stdin-file-path", "{buffer_path}"],
    },
  },
  "format_on_save": "on",
  "languages": {
    "JSON": {
      "tab_size": 2,
      "formatter": {
        "external": {
          "command": "biome",
          "arguments": ["format", "--stdin-file-path", "{buffer_path}"],
        },
      },
    },
  },
  "ssh_connections": [
    {
      "host": "gpu-server",
      "args": [],
      "projects": [
        {
          "paths": [
            "/Users/raghav"
          ]
        },
        {
          "paths": [
            "/home/raghav/.claude"
          ]
        },
        {
          "paths": [
            "/home/raghav/environment-generation"
          ]
        },
        {
          "paths": [
            "/home/raghav/internal-infra"
          ]
        },
        {
          "paths": [
            "/home/raghav/monorepo"
          ]
        },
        {
          "paths": [
            "/home/raghav/vuln-research"
          ]
        },
        {
          "paths": [
            "/home/raghav/zealot-platform-new"
          ]
        },
        {
          "paths": [
            "/tmp/vuln-research-repos.csv"
          ]
        }
      ]
    },
    {
      "host": "mac-mini",
      "args": [],
      "projects": []
    }
  ],
  "icon_theme": {
    "mode": "system",
    "light": "Material Icon Theme",
    "dark": "Material Icon Theme",
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "terminal": {
    "font_size": 15.0,
    "max_scroll_history_lines": 3000,
  },
  "git": {
    "inline_blame": {
      "enabled": true,
    },
  },
  "base_keymap": "VSCode",
  "sticky_scroll": {
    "enabled": true,
  },
  "gutter": {
    "line_numbers": true,
    "runnables": false,
    "breakpoints": false,
    "folds": true,
    "min_line_number_digits": 3,
  },
  "buffer_font_fallbacks": ["monospace"],
  "buffer_font_family": "Geist Mono",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark Pro",
  },
  "use_system_window_tabs": true,
}
